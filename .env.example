# ─────────────────────────────────────────────────────────────────────────────
# Mynx environment template. Copy to server/.env (and client/.env if needed).
# NEVER commit real secrets. NEVER use production credentials or customer data
# in development or staging.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Docker Compose: postgresql://mynx:mynx_dev@localhost:5432/mynx_dev?schema=public
# Local cluster (npm run db:local:init): port 5433
DATABASE_URL=postgresql://mynx:mynx_dev@127.0.0.1:5433/mynx_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated explicit allowlist. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# sandbox | live. "live" is refused unless NODE_ENV=production, and real-money
# features additionally require the go-live approval setting (see security.md).
PLATFORM_MODE=sandbox

# Number of trusted reverse-proxy hops (1 behind Nginx).
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-generate-a-48-byte-random-secret-value
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# 32 random bytes, base64. Encrypts TOTP secrets at rest. Rotating it invalidates MFA enrolments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Encrypts backups made by `npm run backup:drill`. Must differ from ENCRYPTION_KEY in production and be stored
# separately from the backups. Outside production the drill falls back to ENCRYPTION_KEY when unset.
# BACKUP_ENCRYPTION_KEY=

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Per signed-in user, per minute, for expensive actions (statements, uploads, quotes, exports).
HEAVY_RATE_LIMIT_MAX=30
# Bearer token for GET /api/v1/health/metrics (Prometheus format). Leave unset to disable the endpoint.
# METRICS_TOKEN=<at least 24 random characters>
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
MFA_ISSUER=Mynx

# sandbox = messages are stored in outbound_messages but never sent.
EMAIL_PROVIDER=sandbox
SMS_PROVIDER=sandbox

QUEUE_PREFIX=mynx
ENABLE_QUEUES=true

# ── Client (Vite exposes only VITE_* vars to the browser) ────────────────────
# Leave empty in development. Vite proxies /api to the server.
VITE_API_BASE_URL=

# Private KYC document storage (AES-256-GCM encrypted at rest). Relative paths resolve from server/.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/private
UPLOAD_MAX_BYTES=10485760
DOCUMENT_URL_TTL_SECONDS=300
SCREENING_PROVIDER=sandbox

# Payments. sandbox = simulated provider (no real money). paystack needs a TEST key (sk_test_...); live keys are refused outside live mode.
PAYMENT_PROVIDER=sandbox
# PAYSTACK_SECRET_KEY=sk_test_...
# Optional. Defaults to a value derived from SESSION_SECRET.
# SANDBOX_WEBHOOK_SECRET=<at least 32 characters>
# Limits in minor units (pesewas).
DEPOSIT_MIN_MINOR=1000
DEPOSIT_MAX_MINOR=5000000
WITHDRAWAL_MIN_MINOR=1000
WITHDRAWAL_FEE_MINOR=0
LARGE_WITHDRAWAL_MINOR=1000000
