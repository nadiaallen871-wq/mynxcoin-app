{
  "name": "mynx-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Mynx investment platform: modular monolith (React + Express + PostgreSQL + Prisma)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:worker": "npm run worker:dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local:init": "node infrastructure/local/pg-local.mjs init",
    "db:local:start": "node infrastructure/local/pg-local.mjs start",
    "db:local:stop": "node infrastructure/local/pg-local.mjs stop",
    "db:local:status": "node infrastructure/local/pg-local.mjs status",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "backup:drill": "node infrastructure/backup/restore-drill.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
