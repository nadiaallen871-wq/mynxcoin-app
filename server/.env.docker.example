# Copy to server/.env.docker for `docker compose --profile app up`. Development values only.
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://mynx:mynx_dev@postgres:5432/mynx_dev?schema=public
REDIS_URL=redis://redis:6379
# The browser reaches the stack via Nginx on :8080 (same origin), so no CORS origins are needed.
CORS_ORIGINS=
APP_BASE_URL=http://localhost:8080
PLATFORM_MODE=sandbox
TRUST_PROXY=1
SESSION_SECRET=replace-with-48-random-bytes-base64url-before-use
QUEUE_PREFIX=mynx
ENCRYPTION_KEY=replace-with-32-random-bytes-base64
