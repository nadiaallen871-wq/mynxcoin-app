# Copy to server/.env.test. The database name MUST end in _test.
NODE_ENV=test
DATABASE_URL=postgresql://mynx:mynx_dev@127.0.0.1:5433/mynx_test?schema=public
REDIS_URL=redis://127.0.0.1:6379/1
CORS_ORIGINS=http://localhost:5173
PLATFORM_MODE=sandbox
SESSION_SECRET=test-only-session-secret-at-least-32-characters
ENCRYPTION_KEY=dGVzdC1vbmx5LWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=
QUEUE_PREFIX=mynx-test
ENABLE_QUEUES=false
# Generous limits for tests. Specific tests override them to check limiting.
RATE_LIMIT_MAX=100000
AUTH_RATE_LIMIT_MAX=100000
HEAVY_RATE_LIMIT_MAX=100000

# Encrypted document storage for tests (git-ignored)
STORAGE_LOCAL_DIR=../.devdata/storage-test
