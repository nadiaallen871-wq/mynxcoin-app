{
  "name": "@mynx/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "worker:dev": "node --watch --env-file-if-exists=.env src/worker.js",
    "worker": "node src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.js",
    "perf:smoke": "node --env-file=.env.test scripts/perf-smoke.js",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "deepmerge-ts": "^8.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "multer": "^2.5.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
