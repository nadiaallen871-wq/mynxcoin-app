// Mynx: PostgreSQL schema.
//
// Conventions
// - Table and column names are snake_case (@@map / @map). Prisma fields are camelCase.
// - Primary keys are UUIDs generated by the database.
// - Money is stored as BIGINT minor units (`*_minor`) next to a `currency` code.
//   Rates and prices use NUMERIC(28,10). Floats are never used for money.
// - Append-only tables (audit_logs; ledger tables from Phase 5) are protected by
//   triggers defined in raw SQL inside the migrations.
//
// Phase 1 creates the foundation tables. Later phases add tables through new migrations.
// The full planned model is in documentation/database.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum UserType {
  INDIVIDUAL
  INSTITUTIONAL
  STAFF
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-cased and trimmed by the users service.
  email             String     @unique @db.VarChar(320)
  type              UserType   @default(INDIVIDUAL)
  status            UserStatus @default(PENDING_VERIFICATION)
  /// Argon2id PHC string. Null only for invited staff who have not yet set a password.
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// E.164 format, set only once verified.
  phone             String?    @unique @db.VarChar(20)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            UserProfile?
  sessions           UserSession[]
  mfa                MfaConfiguration?
  recoveryCodes      RecoveryCode[]
  verificationTokens VerificationToken[]
  loginAttempts      LoginAttempt[]
  messages           OutboundMessage[]
  roles              UserRole[]                @relation("UserRoles")
  grantedRoles       UserRole[]                @relation("RoleGrantor")
  auditLogs          AuditLog[]
  settingChanges     SystemSetting[]
  investorProfile    InvestorProfile?
  riskAssessments    RiskAssessment[]
  kycApplications    KycApplication[]          @relation("KycApplicant")
  kycReviews         KycApplication[]          @relation("KycReviewer")
  kycEvents          KycReviewEvent[]
  documents          InvestorDocument[]        @relation("DocumentOwner")
  documentReviews    InvestorDocument[]        @relation("DocumentReviewer")
  documentAccess     DocumentAccessLog[]
  productsCreated    InvestmentProduct[]       @relation("ProductCreator")
  productsUpdated    InvestmentProduct[]       @relation("ProductUpdater")
  productsPublished  InvestmentProduct[]       @relation("ProductPublisher")
  productVersions    ProductVersion[]
  performanceRecords PerformanceRecord[]
  ledgerAccounts     LedgerAccount[]
  wallets            Wallet[]
  journalEntries     JournalEntry[]
  adjustmentsMade    LedgerAdjustment[]        @relation("AdjustmentRequester")
  adjustmentsDecided LedgerAdjustment[]        @relation("AdjustmentDecider")
  adjustmentsFor     LedgerAdjustment[]        @relation("AdjustmentCustomer")
  idempotencyKeys    IdempotencyKey[]
  reconciliations    ReconciliationRun[]
  payments           Payment[]
  deposits           Deposit[]
  withdrawals        Withdrawal[]              @relation("WithdrawalOwner")
  withdrawalReviews  Withdrawal[]              @relation("WithdrawalReviewer")
  investmentOrders   InvestmentOrder[]         @relation("OrderInvestor")
  orderDecisions     InvestmentOrder[]         @relation("OrderDecider")
  allocations        InvestmentAllocation[]
  holdings           InvestmentHolding[]       @relation("HoldingOwner")
  holdingSettlements InvestmentHolding[]       @relation("HoldingSettler")
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  referralCode       ReferralCode?
  referralsMade      Referral[]                @relation("Referrer")
  referredBy         Referral?                 @relation("Referred")
  referralRewards    ReferralReward[]
  campaignsCreated   ReferralCampaign[]        @relation("CampaignCreator")
  campaignsApproved  ReferralCampaign[]        @relation("CampaignApprover")
  tickets            SupportTicket[]           @relation("TicketOwner")
  ticketsAssigned    SupportTicket[]           @relation("TicketAssignee")
  ticketMessages     SupportMessage[]
  generatedDocuments GeneratedDocument[]
  generatedAccess    GeneratedDocumentAccess[]
  approvalsRequested ApprovalRequest[]         @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[]         @relation("ApprovalDecider")
  alerts             MonitoringAlert[]         @relation("AlertSubject")
  alertsReviewed     MonitoringAlert[]         @relation("AlertReviewer")
  casesAbout         ComplianceCase[]          @relation("CaseSubject")
  casesAssigned      ComplianceCase[]          @relation("CaseAssignee")
  casesOpened        ComplianceCase[]          @relation("CaseOpener")
  caseEvents         ComplianceCaseEvent[]     @relation("CaseEventActor")
  fxQuotes           FxQuote[]
  conversions        CurrencyConversion[]
  taxRulesCreated    TaxRule[]                 @relation("TaxRuleCreator")
  taxRulesApproved   TaxRule[]                 @relation("TaxRuleApprover")

  @@index([status])
  @@index([type])
  @@map("users")
}

model UserProfile {
  userId           String   @id @map("user_id") @db.Uuid
  firstName        String   @map("first_name") @db.VarChar(100)
  lastName         String   @map("last_name") @db.VarChar(100)
  /// Institutional investors only.
  organizationName String?  @map("organization_name") @db.VarChar(200)
  /// ISO 3166-1 alpha-2
  country          String   @default("GH") @db.Char(2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Server-side session. The cookie holds a random token. Only its HMAC is stored.
model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  /// True when the user has MFA enabled and must complete a challenge.
  mfaRequired       Boolean   @default(false) @map("mfa_required")
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  mfaFailedAttempts Int       @default(0) @map("mfa_failed_attempts")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model MfaConfiguration {
  userId          String    @id @map("user_id") @db.Uuid
  /// AES-256-GCM encrypted base32 TOTP secret (iv:tag:ciphertext).
  secretEncrypted String    @map("secret_encrypted") @db.VarChar(255)
  /// Null while enrolment is pending confirmation.
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(6)
  /// Last accepted TOTP time-step, so a code cannot be replayed.
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_configurations")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_SETUP
}

/// Single-use tokens for email verification, phone codes, password reset and staff account setup.
/// Only an HMAC of the token is stored.
model VerificationToken {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash") @db.Char(64)
  /// The email or phone number the token proves ownership of.
  target     String?               @db.VarChar(320)
  attempts   Int                   @default(0)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@map("verification_tokens")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(320)
  userId    String?  @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  success   Boolean
  /// e.g. OK, BAD_PASSWORD, UNKNOWN_EMAIL, LOCKED, NOT_VERIFIED, SUSPENDED, MFA_FAILED
  reason    String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

/// Transactional outbox for email and SMS. Rows are written in the same DB
/// transaction as the business event, then delivered by the worker. Bodies that
/// contain secrets (links, codes) are redacted after delivery in staging and production.
model OutboundMessage {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?        @map("user_id") @db.Uuid
  channel           MessageChannel
  recipient         String         @db.VarChar(320)
  template          String         @db.VarChar(64)
  subject           String?        @db.VarChar(200)
  body              String?
  containsSecret    Boolean        @default(false) @map("contains_secret")
  status            MessageStatus  @default(QUEUED)
  provider          String?        @db.VarChar(32)
  providerMessageId String?        @map("provider_message_id") @db.VarChar(128)
  attempts          Int            @default(0)
  lastError         String?        @map("last_error") @db.VarChar(500)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("outbound_messages")
}

// ─── Phase 3: investor onboarding and KYC ───────────────────────────────────

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  OTHER
}

enum IncomeBand {
  UNDER_12K
  FROM_12K_TO_60K
  FROM_60K_TO_240K
  FROM_240K_TO_1M
  OVER_1M
}

enum InvestmentExperience {
  NONE
  LIMITED
  MODERATE
  EXTENSIVE
}

enum IdentityDocumentType {
  GHANA_CARD
  PASSPORT
  DRIVERS_LICENSE
  VOTER_ID
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  RESUBMISSION_REQUIRED
  APPROVED
  REJECTED
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
}

enum RiskProfile {
  CONSERVATIVE
  MODERATELY_CONSERVATIVE
  BALANCED
  GROWTH
  AGGRESSIVE
}

/// KYC data collected during onboarding. The identity number is encrypted at
/// rest. Only its last four characters are kept in clear for display.
model InvestorProfile {
  userId                 String                @id @map("user_id") @db.Uuid
  // Personal and identity
  dateOfBirth            DateTime?             @map("date_of_birth") @db.Date
  nationality            String?               @db.Char(2)
  idType                 IdentityDocumentType? @map("id_type")
  idNumberEncrypted      String?               @map("id_number_encrypted") @db.VarChar(255)
  idNumberLast4          String?               @map("id_number_last4") @db.VarChar(4)
  idExpiryDate           DateTime?             @map("id_expiry_date") @db.Date
  idIssuingCountry       String?               @map("id_issuing_country") @db.Char(2)
  // Residential address
  addressLine1           String?               @map("address_line1") @db.VarChar(200)
  addressLine2           String?               @map("address_line2") @db.VarChar(200)
  city                   String?               @db.VarChar(100)
  region                 String?               @db.VarChar(100)
  postalCode             String?               @map("postal_code") @db.VarChar(20)
  addressCountry         String?               @map("address_country") @db.Char(2)
  // Employment and source of funds
  employmentStatus       EmploymentStatus?     @map("employment_status")
  occupation             String?               @db.VarChar(120)
  employerName           String?               @map("employer_name") @db.VarChar(200)
  annualIncomeBand       IncomeBand?           @map("annual_income_band")
  sourceOfFunds          String[]              @default([]) @map("source_of_funds")
  sourceOfFundsDetails   String?               @map("source_of_funds_details") @db.VarChar(1000)
  // Investment profile
  investmentObjectives   String[]              @default([]) @map("investment_objectives")
  investmentExperience   InvestmentExperience? @map("investment_experience")
  // Institutional
  registrationNumber     String?               @map("registration_number") @db.VarChar(64)
  incorporationDate      DateTime?             @map("incorporation_date") @db.Date
  incorporationCountry   String?               @map("incorporation_country") @db.Char(2)
  // Declarations
  isPoliticallyExposed   Boolean?              @map("is_politically_exposed")
  pepDetails             String?               @map("pep_details") @db.VarChar(1000)
  taxResidency           String?               @map("tax_residency") @db.Char(2)
  declarationsAcceptedAt DateTime?             @map("declarations_accepted_at") @db.Timestamptz(6)
  // Outcome (written only by the KYC review service)
  kycStatus              KycStatus             @default(NOT_STARTED) @map("kyc_status")
  kycVerifiedAt          DateTime?             @map("kyc_verified_at") @db.Timestamptz(6)
  riskRating             RiskRating?           @map("risk_rating")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([kycStatus])
  @@map("investor_profiles")
}

/// Suitability questionnaire results. Append-only history. The latest row is current.
model RiskAssessment {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  questionnaireVersion String      @map("questionnaire_version") @db.VarChar(20)
  answers              Json
  score                Int
  riskProfile          RiskProfile @map("risk_profile")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("risk_assessments")
}

enum KycApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  RESUBMISSION_REQUIRED
  APPROVED
  REJECTED
}

/// One KYC case per review cycle. Resubmissions stay on the same application (`submissionCount` increments).
model KycApplication {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  status            KycApplicationStatus @default(SUBMITTED)
  submissionCount   Int                  @default(1) @map("submission_count")
  /// Profile as submitted (identity number masked), kept for the audit trail.
  profileSnapshot   Json                 @map("profile_snapshot")
  reviewerId        String?              @map("reviewer_id") @db.Uuid
  riskRating        RiskRating?          @map("risk_rating")
  decisionReason    String?              @map("decision_reason") @db.VarChar(2000)
  resubmissionNotes String?              @map("resubmission_notes") @db.VarChar(2000)
  submittedAt       DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User               @relation("KycApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewer  User?              @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  events    KycReviewEvent[]
  documents InvestorDocument[]
  screening ScreeningResult[]

  @@index([status, submittedAt])
  @@index([userId])
  @@map("kyc_applications")
}

/// Append-only history of every state change on a KYC application.
model KycReviewEvent {
  id            BigInt                @id @default(autoincrement())
  applicationId String                @map("application_id") @db.Uuid
  actorId       String?               @map("actor_id") @db.Uuid
  fromStatus    KycApplicationStatus? @map("from_status")
  toStatus      KycApplicationStatus  @map("to_status")
  note          String?               @db.VarChar(2000)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("kyc_review_events")
}

enum ScreeningStatus {
  CLEAR
  POTENTIAL_MATCH
  ERROR
}

/// Sanctions / PEP screening result for a submission.
model ScreeningResult {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  provider      String          @db.VarChar(32)
  status        ScreeningStatus
  matches       Json            @default("[]")
  screenedName  String          @map("screened_name") @db.VarChar(300)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("screening_results")
}

enum InvestorDocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  PROOF_OF_ADDRESS
  SELFIE
  CERTIFICATE_OF_INCORPORATION
  OTHER
}

enum DocumentStatus {
  UPLOADED
  ACCEPTED
  REJECTED
}

/// Identity and supporting documents. Files live in private, encrypted storage
/// under `storageKey` and are never publicly addressable.
model InvestorDocument {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  applicationId    String?              @map("application_id") @db.Uuid
  type             InvestorDocumentType
  status           DocumentStatus       @default(UPLOADED)
  storageKey       String               @unique @map("storage_key") @db.VarChar(255)
  originalFilename String               @map("original_filename") @db.VarChar(255)
  mimeType         String               @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                  @map("size_bytes")
  sha256           String               @db.Char(64)
  reviewerId       String?              @map("reviewer_id") @db.Uuid
  rejectionReason  String?              @map("rejection_reason") @db.VarChar(500)
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  /// Superseded by a newer upload of the same type (kept for retention).
  supersededAt     DateTime?            @map("superseded_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User                @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer    User?               @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  application KycApplication?     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  accessLogs  DocumentAccessLog[]

  @@index([userId, type, supersededAt])
  @@index([applicationId])
  @@map("investor_documents")
}

/// Append-only log of every document upload, URL issue and download.
model DocumentAccessLog {
  id         BigInt   @id @default(autoincrement())
  documentId String   @map("document_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(32)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document InvestorDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actor    User?            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("document_access_logs")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key, e.g. FINANCE_OFFICER.
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  /// System roles are seeded from code and cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// resource:action[:scope], e.g. withdrawals:approve
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Append-only. UPDATE, DELETE and TRUNCATE are rejected by a trigger.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  requestId  String?  @map("request_id") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Currency {
  /// ISO 4217 code
  code       String   @id @db.Char(3)
  name       String   @db.VarChar(64)
  symbol     String   @db.VarChar(8)
  /// Decimal exponent: GHS = 2, JPY = 0
  minorUnits Int      @map("minor_units") @db.SmallInt
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products       InvestmentProduct[]
  ledgerAccounts LedgerAccount[]
  wallets        Wallet[]
  campaigns      ReferralCampaign[]
  rates          ExchangeRate[]      @relation("RateCurrency")

  @@map("currencies")
}

/// Platform configuration. Changes are versioned and audited, and sensitive
/// keys require maker-checker approval (Phase 8).
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  isSensitive Boolean  @default(false) @map("is_sensitive")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// ─── Phase 4: investment marketplace ────────────────────────────────────────

model InvestmentCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products InvestmentProduct[]

  @@map("investment_categories")
}

enum ProductType {
  TREASURY_BILL
  GOVERNMENT_BOND
  CORPORATE_BOND
  FIXED_DEPOSIT
  MONEY_MARKET_FUND
  FIXED_INCOME_FUND
  EQUITY_FUND
  BALANCED_FUND
  REAL_ESTATE
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CLOSED
  ARCHIVED
}

/// FIXED: contractually fixed rate (still subject to issuer default).
/// TARGET: indicative/target rate, not guaranteed. NONE: no stated rate (e.g. equity funds).
enum ReturnType {
  FIXED
  TARGET
  NONE
}

/// Investment product terms. Money is in minor units of `currency`. Rates are
/// decimal fractions (0.1250 = 12.5%). Published products cannot be edited: they
/// must be suspended first, and republishing needs a second person (four-eyes).
model InvestmentProduct {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String        @unique @db.VarChar(120)
  name                  String        @db.VarChar(160)
  shortDescription      String        @map("short_description") @db.VarChar(300)
  description           String
  categoryId            String        @map("category_id") @db.Uuid
  productType           ProductType   @map("product_type")
  issuerName            String        @map("issuer_name") @db.VarChar(200)
  currency              String        @db.Char(3)
  minInvestmentMinor    BigInt        @map("min_investment_minor")
  maxInvestmentMinor    BigInt?       @map("max_investment_minor")
  incrementMinor        BigInt?       @map("increment_minor")
  capacityMinor         BigInt?       @map("capacity_minor")
  returnType            ReturnType    @map("return_type")
  annualRate            Decimal?      @map("annual_rate") @db.Decimal(28, 10)
  termDays              Int?          @map("term_days")
  maturityDate          DateTime?     @map("maturity_date") @db.Date
  lockupDays            Int?          @map("lockup_days")
  redemptionTerms       String        @map("redemption_terms") @db.VarChar(2000)
  entryFeeRate          Decimal       @default(0) @map("entry_fee_rate") @db.Decimal(28, 10)
  managementFeeRate     Decimal       @default(0) @map("management_fee_rate") @db.Decimal(28, 10)
  earlyExitFeeRate      Decimal       @default(0) @map("early_exit_fee_rate") @db.Decimal(28, 10)
  feeNotes              String?       @map("fee_notes") @db.VarChar(1000)
  /// 1 (lowest) to 7 (highest), similar to the SRRI scale.
  riskLevel             Int           @map("risk_level") @db.SmallInt
  /// Lowest investor risk profile for which the product is considered suitable.
  minRiskProfile        RiskProfile   @map("min_risk_profile")
  riskDisclosure        String        @map("risk_disclosure")
  eligibleInvestorTypes UserType[]    @default([INDIVIDUAL, INSTITUTIONAL]) @map("eligible_investor_types")
  subscriptionOpensAt   DateTime?     @map("subscription_opens_at") @db.Timestamptz(6)
  subscriptionClosesAt  DateTime?     @map("subscription_closes_at") @db.Timestamptz(6)
  status                ProductStatus @default(DRAFT)
  statusReason          String?       @map("status_reason") @db.VarChar(500)
  version               Int           @default(0)
  createdById           String        @map("created_by_id") @db.Uuid
  updatedById           String        @map("updated_by_id") @db.Uuid
  publishedById         String?       @map("published_by_id") @db.Uuid
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    InvestmentCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currencyRef Currency            @relation(fields: [currency], references: [code], onDelete: Restrict)
  createdBy   User                @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                @relation("ProductUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  publishedBy User?               @relation("ProductPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  documents   ProductDocument[]
  performance PerformanceRecord[]
  versions    ProductVersion[]
  orders      InvestmentOrder[]
  holdings    InvestmentHolding[]

  @@index([status, categoryId])
  @@index([status, publishedAt])
  @@map("investment_products")
}

enum ProductDocumentKind {
  KEY_INFORMATION
  TERM_SHEET
  PROSPECTUS
  RISK_DISCLOSURE
  ANNUAL_REPORT
  OTHER
}

/// Public product documentation (term sheets, prospectus). Served only while the product is visible.
model ProductDocument {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String              @map("product_id") @db.Uuid
  kind       ProductDocumentKind
  title      String              @db.VarChar(200)
  storageKey String              @unique @map("storage_key") @db.VarChar(255)
  mimeType   String              @map("mime_type") @db.VarChar(100)
  sizeBytes  Int                 @map("size_bytes")
  sha256     String              @db.Char(64)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  product InvestmentProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_documents")
}

/// Historical performance with a mandatory source. Append-only: figures are never edited after recording.
model PerformanceRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  /// Return over the period as a decimal fraction (net of fees unless the source says otherwise).
  returnRate   Decimal  @map("return_rate") @db.Decimal(28, 10)
  source       String   @db.VarChar(300)
  sourceUrl    String?  @map("source_url") @db.VarChar(500)
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    InvestmentProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  recordedBy User              @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([productId, periodStart, periodEnd])
  @@map("performance_records")
}

/// Immutable snapshot of a product's terms each time it is published. Orders (Phase 6) reference the version they were placed against.
model ProductVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  version       Int
  snapshot      Json
  publishedById String   @map("published_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product     InvestmentProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  publishedBy User              @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([productId, version])
  @@map("product_versions")
}

// ─── Phase 5: double-entry ledger, wallets, idempotency, reconciliation ──────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CLEARING
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountPurpose {
  OPERATIONAL_BANK
  CLIENT_MONEY_BANK
  PAYMENT_CLEARING
  INVESTMENT_POSITIONS
  CUSTOMER_AVAILABLE
  CUSTOMER_RESERVED
  WITHDRAWALS_PAYABLE
  SUBSCRIPTIONS_PENDING
  CUSTOMER_HOLDINGS
  RETAINED_EARNINGS
  MANUAL_ADJUSTMENTS
  FEE_INCOME_MANAGEMENT
  FEE_INCOME_TRANSACTION
  PROVIDER_CHARGES
  REFERRAL_EXPENSE
  FX_CLEARING
}

/// Chart of accounts. System accounts have no owner. Customer wallet accounts
/// (CUSTOMER_AVAILABLE / CUSTOMER_RESERVED) belong to one user and can never go negative.
/// Purpose, type, normal balance, currency and owner are immutable (DB trigger).
model LedgerAccount {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @db.VarChar(16)
  name          String         @db.VarChar(160)
  type          AccountType
  normalBalance NormalBalance  @map("normal_balance")
  purpose       AccountPurpose
  currency      String         @db.Char(3)
  ownerUserId   String?        @map("owner_user_id") @db.Uuid
  allowNegative Boolean        @default(true) @map("allow_negative")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  currencyRef Currency              @relation(fields: [currency], references: [code], onDelete: Restrict)
  owner       User?                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  balance     LedgerAccountBalance?
  lines       JournalLine[]

  @@index([ownerUserId])
  @@index([purpose, currency])
  @@map("ledger_accounts")
}

/// Running balance per account (debit-positive), maintained only by the posting
/// trigger. Direct writes are rejected, and reconciliation verifies it against the lines.
model LedgerAccountBalance {
  accountId    String   @id @map("account_id") @db.Uuid
  balanceMinor BigInt   @default(0) @map("balance_minor")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("ledger_account_balances")
}

/// A posted, balanced, immutable journal entry. Corrections are made by reversal entries.
model JournalEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryNumber     BigInt   @unique @default(autoincrement()) @map("entry_number")
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(200)
  type            String   @db.VarChar(40)
  description     String   @db.VarChar(500)
  referenceType   String?  @map("reference_type") @db.VarChar(40)
  referenceId     String?  @map("reference_id") @db.VarChar(64)
  reversesEntryId String?  @unique @map("reverses_entry_id") @db.Uuid
  postedById      String?  @map("posted_by_id") @db.Uuid
  metadata        Json?
  postedAt        DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  lines      JournalLine[]
  postedBy   User?         @relation(fields: [postedById], references: [id], onDelete: Restrict)
  reverses   JournalEntry? @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("Reversal")

  @@index([type, postedAt])
  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@map("journal_entries")
}

/// Signed amount in minor units: positive = debit, negative = credit.
model JournalLine {
  id          BigInt  @id @default(autoincrement())
  entryId     String  @map("entry_id") @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  amountMinor BigInt  @map("amount_minor")
  currency    String  @db.Char(3)
  memo        String? @db.VarChar(300)

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId, id])
  @@map("journal_lines")
}

enum WalletStatus {
  ACTIVE
  FROZEN
}

/// One wallet per user and currency. Balances are not stored here: they come
/// from the user's CUSTOMER_AVAILABLE and CUSTOMER_RESERVED ledger accounts.
model Wallet {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  currency     String       @db.Char(3)
  status       WalletStatus @default(ACTIVE)
  statusReason String?      @map("status_reason") @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([userId, currency])
  @@map("wallets")
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdjustmentDirection {
  CREDIT
  DEBIT
}

/// Maker-checker manual adjustment of a customer wallet. Nothing is posted until
/// a different person with `ledger:adjustment:approve` approves it.
model LedgerAdjustment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  currency       String              @db.Char(3)
  direction      AdjustmentDirection
  amountMinor    BigInt              @map("amount_minor")
  reason         String              @db.VarChar(1000)
  status         AdjustmentStatus    @default(PENDING)
  requestedById  String              @map("requested_by_id") @db.Uuid
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decisionNote   String?             @map("decision_note") @db.VarChar(1000)
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(6)
  journalEntryId String?             @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  customer    User  @relation("AdjustmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("AdjustmentDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("ledger_adjustments")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// Stored responses for financial POSTs carrying an Idempotency-Key header, so a retried request returns the original result.
model IdempotencyKey {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String            @db.VarChar(128)
  userId         String            @map("user_id") @db.Uuid
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(300)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum ReconciliationStatus {
  PASSED
  FAILED
}

model ReconciliationRun {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String               @db.VarChar(40)
  status        ReconciliationStatus
  summary       Json
  discrepancies Json                 @default("[]")
  triggeredById String?              @map("triggered_by_id") @db.Uuid
  startedAt     DateTime             @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime             @map("finished_at") @db.Timestamptz(6)

  triggeredBy User? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([type, startedAt])
  @@map("reconciliation_runs")
}

// ─── Phase 6: payments, deposits, withdrawals, investment engine ────────────

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// One interaction with a payment provider (collection or payout). `reference` is ours and is sent to the provider.
model Payment {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  direction             PaymentDirection
  provider              String           @db.VarChar(32)
  reference             String           @unique @db.VarChar(64)
  providerTransactionId String?          @map("provider_transaction_id") @db.VarChar(128)
  amountMinor           BigInt           @map("amount_minor")
  feeMinor              BigInt           @default(0) @map("fee_minor")
  currency              String           @db.Char(3)
  status                PaymentStatus    @default(INITIATED)
  checkoutUrl           String?          @map("checkout_url") @db.VarChar(500)
  failureReason         String?          @map("failure_reason") @db.VarChar(500)
  lastVerifiedAt        DateTime?        @map("last_verified_at") @db.Timestamptz(6)
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  deposit    Deposit?
  withdrawal Withdrawal?

  @@unique([provider, providerTransactionId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Raw, signature-checked provider webhook. (provider, eventId) is unique, so replays are ignored.
model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String    @db.VarChar(32)
  eventId         String    @map("event_id") @db.VarChar(128)
  eventType       String    @map("event_type") @db.VarChar(64)
  reference       String?   @db.VarChar(64)
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError String?   @map("processing_error") @db.VarChar(500)

  @@unique([provider, eventId])
  @@index([reference])
  @@map("payment_webhook_events")
}

/// Simulated external provider state for the sandbox provider. It plays the role of the provider's own database.
model SandboxProviderTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference   String   @unique @db.VarChar(64)
  kind        String   @db.VarChar(16)
  status      String   @db.VarChar(16)
  amountMinor BigInt   @map("amount_minor")
  feeMinor    BigInt   @default(0) @map("fee_minor")
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sandbox_provider_transactions")
}

enum DepositStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED
}

model Deposit {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  paymentId      String        @unique @map("payment_id") @db.Uuid
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  status         DepositStatus @default(INITIATED)
  journalEntryId String?       @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("deposits")
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
  RETURNED
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_ACCOUNT
}

/// Funds move from the wallet to "withdrawals payable" (2100) at request time, so they cannot be spent twice.
model Withdrawal {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  amountMinor          BigInt           @map("amount_minor")
  feeMinor             BigInt           @default(0) @map("fee_minor")
  currency             String           @db.Char(3)
  status               WithdrawalStatus @default(REQUESTED)
  method               PayoutMethod
  /// AES-256-GCM encrypted JSON of the payout destination. Only a masked form is ever returned.
  destinationEncrypted String           @map("destination_encrypted") @db.VarChar(1000)
  destinationMasked    String           @map("destination_masked") @db.VarChar(120)
  riskFlags            String[]         @default([]) @map("risk_flags")
  requestEntryId       String?          @unique @map("request_entry_id") @db.Uuid
  settlementEntryId    String?          @unique @map("settlement_entry_id") @db.Uuid
  returnEntryId        String?          @unique @map("return_entry_id") @db.Uuid
  paymentId            String?          @unique @map("payment_id") @db.Uuid
  reviewedById         String?          @map("reviewed_by_id") @db.Uuid
  reviewNote           String?          @map("review_note") @db.VarChar(1000)
  failureReason        String?          @map("failure_reason") @db.VarChar(500)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt            DateTime?        @map("decided_at") @db.Timestamptz(6)
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz(6)

  user       User     @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

enum OrderStatus {
  DRAFT
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  CONFIRMED
  ACTIVE
  PARTIALLY_REDEEMED
  REDEMPTION_PENDING
  MATURED
  CANCELLED
  REJECTED
  FAILED
}

/// Subscription to a product. Funds are reserved in the wallet when it is placed, and the
/// order is tied to the product version (terms) the investor saw.
model InvestmentOrder {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber            BigInt       @unique @default(autoincrement()) @map("order_number")
  userId                 String       @map("user_id") @db.Uuid
  productId              String       @map("product_id") @db.Uuid
  productVersion         Int          @map("product_version")
  amountMinor            BigInt       @map("amount_minor")
  feeMinor               BigInt       @map("fee_minor")
  currency               String       @db.Char(3)
  status                 OrderStatus  @default(PENDING)
  riskDisclosureAccepted Boolean      @map("risk_disclosure_accepted")
  unsuitableAcknowledged Boolean      @default(false) @map("unsuitable_acknowledged")
  investorRiskProfile    RiskProfile? @map("investor_risk_profile")
  reserveEntryId         String?      @unique @map("reserve_entry_id") @db.Uuid
  confirmEntryId         String?      @unique @map("confirm_entry_id") @db.Uuid
  releaseEntryId         String?      @unique @map("release_entry_id") @db.Uuid
  decidedById            String?      @map("decided_by_id") @db.Uuid
  decisionNote           String?      @map("decision_note") @db.VarChar(1000)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt            DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  closedAt               DateTime?    @map("closed_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                  @relation("OrderInvestor", fields: [userId], references: [id], onDelete: Restrict)
  product    InvestmentProduct     @relation(fields: [productId], references: [id], onDelete: Restrict)
  decidedBy  User?                 @relation("OrderDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  allocation InvestmentAllocation?
  holding    InvestmentHolding?

  @@index([userId, createdAt])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("investment_orders")
}

/// Evidence that an order was placed with the underlying asset or custodian. Required for confirmation.
model InvestmentAllocation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String   @unique @map("order_id") @db.Uuid
  principalMinor     BigInt   @map("principal_minor")
  custodianReference String   @map("custodian_reference") @db.VarChar(120)
  notes              String?  @db.VarChar(1000)
  allocatedById      String   @map("allocated_by_id") @db.Uuid
  allocatedAt        DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)

  order       InvestmentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  allocatedBy User            @relation(fields: [allocatedById], references: [id], onDelete: Restrict)

  @@map("investment_allocations")
}

enum HoldingStatus {
  ACTIVE
  MATURITY_DUE
  MATURED
}

model InvestmentHolding {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  orderId            String        @unique @map("order_id") @db.Uuid
  principalMinor     BigInt        @map("principal_minor")
  currency           String        @db.Char(3)
  status             HoldingStatus @default(ACTIVE)
  startDate          DateTime      @map("start_date") @db.Date
  maturityDate       DateTime?     @map("maturity_date") @db.Date
  proceedsMinor      BigInt?       @map("proceeds_minor")
  managementFeeMinor BigInt?       @map("management_fee_minor")
  custodianReference String?       @map("custodian_reference") @db.VarChar(120)
  settlementEntryId  String?       @unique @map("settlement_entry_id") @db.Uuid
  /// Investor asked to reinvest the proceeds into the same product at maturity.
  rollover           Boolean       @default(false)
  /// Product terms version the investor consented to; a rollover never uses changed terms.
  rolloverVersion    Int?          @map("rollover_version")
  rolloverConsentAt  DateTime?     @map("rollover_consent_at") @db.Timestamptz(6)
  rolloverOrderId    String?       @unique @map("rollover_order_id") @db.Uuid
  rolloverNote       String?       @map("rollover_note") @db.VarChar(300)
  settledById        String?       @map("settled_by_id") @db.Uuid
  maturedAt          DateTime?     @map("matured_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User              @relation("HoldingOwner", fields: [userId], references: [id], onDelete: Restrict)
  product   InvestmentProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     InvestmentOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  settledBy User?             @relation("HoldingSettler", fields: [settledById], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, maturityDate])
  @@map("investment_holdings")
}

// ─── Phase 7: investor experience ───────────────────────────────────────────

enum NotificationCategory {
  ACCOUNT
  SECURITY
  KYC
  PAYMENTS
  INVESTMENTS
  REFERRALS
  SUPPORT
}

/// In-app notification centre. Written in the same transaction as the business event.
model Notification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  template  String               @db.VarChar(64)
  title     String               @db.VarChar(200)
  body      String               @db.VarChar(2000)
  link      String?              @db.VarChar(300)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Per-category channel choices. Missing rows mean the defaults (email and in-app on, SMS off).
/// Security and account messages are always sent by email whatever is stored here.
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  email     Boolean              @default(true)
  sms       Boolean              @default(false)
  inApp     Boolean              @default(true) @map("in_app")
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// Referral reward rules. Campaigns start inactive and must be activated by a second
/// person after compliance review of the promotion (financial promotion rules).
model ReferralCampaign {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String    @db.VarChar(120)
  description           String?   @db.VarChar(1000)
  currency              String    @db.Char(3)
  rewardMinor           BigInt    @map("reward_minor")
  /// The referred investor must have a confirmed investment of at least this amount.
  minInvestmentMinor    BigInt    @map("min_investment_minor")
  maxRewardsPerReferrer Int?      @map("max_rewards_per_referrer")
  startsAt              DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime? @map("ends_at") @db.Timestamptz(6)
  active                Boolean   @default(false)
  createdById           String    @map("created_by_id") @db.Uuid
  approvedById          String?   @map("approved_by_id") @db.Uuid
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  currencyRef Currency         @relation(fields: [currency], references: [code], onDelete: Restrict)
  createdBy   User             @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?            @relation("CampaignApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  referrals   Referral[]
  rewards     ReferralReward[]

  @@index([active, startsAt])
  @@map("referral_campaigns")
}

model ReferralCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
  NOT_ELIGIBLE
}

/// Attribution is fixed at registration and cannot be changed afterwards.
model Referral {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  campaignId     String?        @map("campaign_id") @db.Uuid
  status         ReferralStatus @default(PENDING)
  /// Anti-abuse signals. A flagged referral is never paid automatically.
  flags          String[]       @default([])
  /// HMAC of the registration IP, compared with the referrer, never the raw address.
  signupIpHash   String?        @map("signup_ip_hash") @db.Char(64)
  decisionNote   String?        @map("decision_note") @db.VarChar(500)
  qualifiedAt    DateTime?      @map("qualified_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  referrer User              @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referred User              @relation("Referred", fields: [referredUserId], references: [id], onDelete: Restrict)
  campaign ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reward   ReferralReward?

  @@index([referrerId, createdAt])
  @@index([status])
  @@map("referrals")
}

/// Payout record. Append-only, and always backed by a ledger entry (Dr 5100 / Cr referrer wallet).
model ReferralReward {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referralId     String   @unique @map("referral_id") @db.Uuid
  referrerId     String   @map("referrer_id") @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.Char(3)
  journalEntryId String   @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referral Referral         @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrer User             @relation(fields: [referrerId], references: [id], onDelete: Restrict)
  campaign ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([referrerId, createdAt])
  @@map("referral_rewards")
}

enum TicketCategory {
  ACCOUNT
  VERIFICATION
  DEPOSITS
  WITHDRAWALS
  INVESTMENTS
  TECHNICAL
  COMPLAINT
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

model SupportTicket {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          Int            @unique @default(autoincrement())
  userId          String         @map("user_id") @db.Uuid
  category        TicketCategory
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus   @default(OPEN)
  subject         String         @db.VarChar(200)
  isComplaint     Boolean        @default(false) @map("is_complaint")
  assigneeId      String?        @map("assignee_id") @db.Uuid
  resolution      String?        @db.VarChar(2000)
  firstResponseAt DateTime?      @map("first_response_at") @db.Timestamptz(6)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(6)
  lastActivityAt  DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz(6)
