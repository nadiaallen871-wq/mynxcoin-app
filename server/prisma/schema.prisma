  body      String   @db.VarChar(5000)
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author      User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        Int      @map("size_bytes")
  sha256           String   @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@map("support_attachments")
}

model Faq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  String   @db.VarChar(60)
  question  String   @db.VarChar(300)
  answer    String   @db.VarChar(5000)
  published Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([published, category, sortOrder])
  @@map("faqs")
}

enum GeneratedDocumentKind {
  ACCOUNT_STATEMENT
  PORTFOLIO_STATEMENT
  TRANSACTION_REPORT
  INVESTMENT_CONFIRMATION
  DEPOSIT_RECEIPT
  WITHDRAWAL_RECEIPT
  TAX_STATEMENT
}

/// Statements, confirmations and receipts produced from ledger records. Each file is
/// stored encrypted and never changes. Regenerating the same scope creates a new version.
model GeneratedDocument {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  kind       GeneratedDocumentKind
  format     String                @db.VarChar(4)
  title      String                @db.VarChar(200)
  /// What the document covers (a period or a record), e.g. "2026-10-01..2026-10-31".
  scope      String                @db.VarChar(120)
  version    Int                   @default(1)
  storageKey String                @unique @map("storage_key") @db.VarChar(255)
  sha256     String                @db.Char(64)
  sizeBytes  Int                   @map("size_bytes")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessLogs GeneratedDocumentAccess[]

  @@unique([userId, kind, format, scope, version])
  @@index([userId, createdAt])
  @@map("generated_documents")
}

/// Append-only log of generation, URL issue and download of generated documents.
model GeneratedDocumentAccess {
  id         BigInt   @id @default(autoincrement())
  documentId String   @map("document_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(32)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actor    User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("generated_document_access")
}

// ─── Phase 8: administration and compliance ─────────────────────────────────

enum ApprovalType {
  SETTING_CHANGE
  ROLE_GRANT
  CURRENCY_STATUS
  TAX_RULE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

/// Generic maker-checker request for high-risk administrative actions. The change is
/// applied only when a different person with the right permission approves it.
model ApprovalRequest {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  /// What will be applied on approval, e.g. { key, from, to } or { userId, roleKey }.
  payload       Json
  summary       String         @db.VarChar(300)
  reason        String         @db.VarChar(1000)
  requestedById String         @map("requested_by_id") @db.Uuid
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decisionNote  String?        @map("decision_note") @db.VarChar(1000)
  error         String?        @db.VarChar(500)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@map("approval_requests")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  DISMISSED
  ESCALATED
}

/// Transaction-monitoring alert raised by a rule. Alerts flag activity for human review;
/// they never block or reverse anything on their own.
model MonitoringAlert {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  rule          String        @db.VarChar(40)
  severity      AlertSeverity
  status        AlertStatus   @default(OPEN)
  summary       String        @db.VarChar(300)
  details       Json?
  referenceType String?       @map("reference_type") @db.VarChar(40)
  referenceId   String?       @map("reference_id") @db.VarChar(64)
  /// One alert per rule and triggering record.
  dedupeKey     String        @unique @map("dedupe_key") @db.VarChar(160)
  caseId        String?       @map("case_id") @db.Uuid
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewNote    String?       @map("review_note") @db.VarChar(1000)
  reviewedAt    DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User            @relation("AlertSubject", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("AlertReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  case       ComplianceCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
  @@map("monitoring_alerts")
}

enum CaseType {
  AML
  SANCTIONS
  PEP
  FRAUD
  KYC
  OTHER
}

enum CaseStatus {
  OPEN
  INVESTIGATING
  ESCALATED
  CLOSED_NO_ACTION
  CLOSED_ACTION_TAKEN
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model ComplianceCase {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number              Int          @unique @default(autoincrement())
  subjectUserId       String       @map("subject_user_id") @db.Uuid
  type                CaseType
  status              CaseStatus   @default(OPEN)
  priority            CasePriority @default(NORMAL)
  title               String       @db.VarChar(200)
  assigneeId          String?      @map("assignee_id") @db.Uuid
  openedById          String       @map("opened_by_id") @db.Uuid
  outcome             String?      @db.VarChar(2000)
  /// Reference of a report filed with the regulator or FIU outside this system. Never filed automatically.
  regulatoryReference String?      @map("regulatory_reference") @db.VarChar(120)
  reportedAt          DateTime?    @map("reported_at") @db.Timestamptz(6)
  closedAt            DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

