/// Case timeline: notes, status changes, assignments and actions. Append-only.
model ComplianceCaseEvent {
  id        BigInt   @id @default(autoincrement())
  caseId    String   @map("case_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  kind      String   @db.VarChar(32)
  body      String?  @db.VarChar(4000)
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case  ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor User           @relation("CaseEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, id])
  @@map("compliance_case_events")
}

// ─── Phase 9: advanced capabilities ─────────────────────────────────────────

/// Exchange-rate snapshots from the configured rate provider. `rate` is the value of one
/// unit of `currency` in the anchor currency (GHS). Append-only, so every conversion can
/// be traced to the exact rate and timestamp it used.
model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency  String   @db.Char(3)
  anchor    String   @db.Char(3)
  rate      Decimal  @db.Decimal(28, 10)
  source    String   @db.VarChar(40)
  /// When the provider published the rate (not when it was stored).
  asOf      DateTime @map("as_of") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currencyRef Currency @relation("RateCurrency", fields: [currency], references: [code], onDelete: Restrict)

  @@index([currency, asOf])
  @@map("exchange_rates")
}

/// A priced offer to convert between two of the investor's own wallets, valid for a short time.
model FxQuote {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  fromCurrency    String    @map("from_currency") @db.Char(3)
  toCurrency      String    @map("to_currency") @db.Char(3)
  fromAmountMinor BigInt    @map("from_amount_minor")
  feeMinor        BigInt    @map("fee_minor")
  toAmountMinor   BigInt    @map("to_amount_minor")
  /// Units of `toCurrency` per unit of `fromCurrency`, before the spread (display only).
  midRate         Decimal   @map("mid_rate") @db.Decimal(28, 10)
  spreadBps       Int       @map("spread_bps")
  fromRateId      String    @map("from_rate_id") @db.Uuid
  toRateId        String    @map("to_rate_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversion CurrencyConversion?

  @@index([userId, createdAt])
  @@map("fx_quotes")
}

/// An executed conversion. Append-only and always backed by a ledger entry that balances
/// in each currency separately through FX clearing (balances are never combined across currencies).
model CurrencyConversion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  quoteId         String   @unique @map("quote_id") @db.Uuid
  fromCurrency    String   @map("from_currency") @db.Char(3)
  toCurrency      String   @map("to_currency") @db.Char(3)
  fromAmountMinor BigInt   @map("from_amount_minor")
  feeMinor        BigInt   @map("fee_minor")
  toAmountMinor   BigInt   @map("to_amount_minor")
  midRate         Decimal  @map("mid_rate") @db.Decimal(28, 10)
  rateAsOf        DateTime @map("rate_as_of") @db.Timestamptz(6)
  journalEntryId  String   @unique @map("journal_entry_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote FxQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("currency_conversions")
}

enum TaxIncomeType {
  INTEREST
  CAPITAL_GAIN
  REFERRAL_REWARD
}

/// Configurable tax rules used for tax statements. None are assumed: every rule must be
/// entered from a qualified tax adviser's guidance and is applied only after approval.
/// Statements show estimates; nothing is withheld from investors automatically.
model TaxRule {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jurisdiction   String        @db.Char(2)
  incomeType     TaxIncomeType @map("income_type")
  /// Applies to all investor types when null.
  investorType   UserType?     @map("investor_type")
  /// Fraction, e.g. 0.08 for 8%.
  rate           Decimal       @db.Decimal(9, 6)
  effectiveFrom  DateTime      @map("effective_from") @db.Date
  effectiveTo    DateTime?     @map("effective_to") @db.Date
  description    String        @db.VarChar(500)
  /// Legal basis or adviser reference.
  legalReference String        @map("legal_reference") @db.VarChar(300)
  active         Boolean       @default(true)
  createdById    String        @map("created_by_id") @db.Uuid
  approvedById   String        @map("approved_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy  User @relation("TaxRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User @relation("TaxRuleApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([jurisdiction, incomeType, effectiveFrom])
  @@map("tax_rules")
}
